# PowerShield-FL environment template.
# Copy to .env and fill in values. NEVER commit the real .env file.
# The project runs fully offline; no API keys are required for the core pipeline.

# Reserved for future external dataset download tokens (not used by default)
# DATASET_DOWNLOAD_TOKEN=

# Optional: override the default results directory
# POWERSHIELD_RESULTS_DIR=results

# Optional: force a compute device (cpu is the tested default)
# POWERSHIELD_DEVICE=cpu
